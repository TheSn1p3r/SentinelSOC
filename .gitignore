# Local runtime config — created automatically on first run (with a fresh
# random API key) from config/config.yaml.example. Never commit this.
/config/config.yaml

# Runtime data/state — not source, regenerated by the app
/data/
/logs/
/quarantine/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Environment files that might carry secrets
.env
.env.*

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
